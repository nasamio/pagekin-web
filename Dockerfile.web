FROM node:22-bookworm

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

WORKDIR /app

# 编译 better-sqlite3 等原生插件所需的构建工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile --ignore-scripts \
  && pnpm rebuild better-sqlite3

COPY . .

RUN pnpm run build:web && pnpm run build:server

ENV NODE_ENV=production
ENV PAGEKIN_PORT=8095
ENV PAGEKIN_DATA_DIR=/data/app-data
ENV PAGEKIN_NOVELS_DIR=/data/novels

RUN mkdir -p /data/app-data /data/novels

EXPOSE 8095

CMD ["node", "dist-server/index.mjs"]
