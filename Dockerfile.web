FROM node:24-bookworm-slim

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

WORKDIR /app

# 使用国内镜像源加速安装编译工具，并清掉代理变量避免走慢速节点
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true \
  && HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= apt-get update \
  && HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= pnpm install --frozen-lockfile --ignore-scripts --registry=https://registry.npmmirror.com \
  && pnpm rebuild better-sqlite3

COPY . .

RUN pnpm run build:web && pnpm run build:server

ENV NODE_ENV=production
ENV PAGEKIN_PORT=8095
ENV PAGEKIN_DATA_DIR=/data/app-data
ENV PAGEKIN_NOVELS_DIR=/data/novels

RUN mkdir -p /data/app-data /data/novels

EXPOSE 8095

CMD ["node", "dist-server/index.mjs"]
